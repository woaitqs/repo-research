  "cards": [
    {
      "dot": "violet",
      "title": "Public vs execution agent",
      "items": [
        "AgentBindings keeps the agent you passed for hooks and results",
        "a prepared clone (sandbox tools, prompt) does the model call"
      ]
    },
    {
      "dot": "emerald",
      "title": "Also attached to a run",
      "items": [
        "Session: history store passed to Runner.run",
        "input/output guardrails live on the Agent; tool guardrails on FunctionTool"
      ]
    },
    {
      "dot": "amber",
      "title": "Sub-agents",
      "items": [
        "Handoff: a tool named transfer_to_<agent> that moves control",
        "Agent.as_tool(): a FunctionTool that runs a nested Runner"
      ]
    }
