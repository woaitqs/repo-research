  "cards": [
    {
      "dot": "violet",
      "title": "Boundary",
      "items": [
        "the model only emits call items and reads output items",
        "hosted tools (web/file search, hosted MCP) run on OpenAI's side"
      ]
    },
    {
      "dot": "rose",
      "title": "Approval",
      "items": [
        "pending calls pause the run; siblings without approval still run",
        "resume re-checks input guardrails, not the approval decision"
      ]
    },
    {
      "dot": "amber",
      "title": "Failure modes",
      "items": [
        "tool exception -> fixed text unless failure_error_function=None",
        "unknown tool -> ModelBehaviorError (opt-in: return error to model)"
      ]
    }
