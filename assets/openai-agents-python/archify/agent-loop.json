  "cards": [
    {
      "dot": "emerald",
      "title": "Loop rule",
      "items": [
        "no tool calls + a message = final output",
        "tool outputs always go back to the model (RunAgain)"
      ]
    },
    {
      "dot": "rose",
      "title": "Resume",
      "items": [
        "resume finishes the paused turn without a new model call",
        "max_turns and the current turn travel inside RunState"
      ]
    },
    {
      "dot": "violet",
      "title": "Handoff",
      "items": [
        "NextStepHandoff swaps current_agent, then the loop prepares the new agent",
        "max_turns (default 10) bounds model calls across all agents"
      ]
    }
  ]
