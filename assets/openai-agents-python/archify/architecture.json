  "cards": [
    {
      "dot": "emerald",
      "title": "Items are the data model",
      "items": [
        "runner, sessions and RunState all store Responses-format items",
        "Chat Completions and LiteLLM adapters convert at the model edge"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent owns no control flow",
      "items": [
        "Agent is a dataclass; the Runner resolves its prompt, tools and handoffs every turn",
        "handoffs and Agent.as_tool are both tool calls from the model's view"
      ]
    },
    {
      "dot": "rose",
      "title": "Pause, not block",
      "items": [
        "needs_approval returns an interruption plus a serializable RunState",
        "SandboxRuntime clones a SandboxAgent per run; the public agent stays unchanged"
      ]
    }
  ]
