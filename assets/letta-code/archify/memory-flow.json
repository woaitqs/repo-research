  "cards": [
    {
      "dot": "violet",
      "title": "What is memory",
      "items": [
        "committed Markdown in a per-agent git repo (MemFS)",
        "root files = core (in prompt); child MEMORY.md dirs = deferred index"
      ]
    },
    {
      "dot": "amber",
      "title": "When the prompt changes",
      "items": [
        "worker / reflection merges recompile the prompt (cache break)",
        "the primary's own commits only add a one-shot <memory_update>"
      ]
    },
    {
      "dot": "cyan",
      "title": "Not memory",
      "items": [
        "conversation history = recall (search via recall sub-agent)",
        "uncommitted edits never reach the prompt"
      ]
    }
  ]
