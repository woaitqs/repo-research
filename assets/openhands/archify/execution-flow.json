  "cards": [
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "Canvas: ConversationClient.createConversation / sendEvent (OpenHands/OpenHands src/api)",
        "Server: start_conversation and send_message routers -> ConversationService -> EventService",
        "SDK only: Conversation(agent, workspace).send_message(); .run()"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ordering guarantees",
      "items": [
        "Each event is persisted before subscribers hear about it (default callback first)",
        "The run loop holds the state FIFO lock per step; send_message can interleave between steps",
        "EventService.run returns 409 if a run task is already live",
        "finish (or a plain text answer) sets FINISHED; the EventService run task then ends"
      ]
    }
  ]
