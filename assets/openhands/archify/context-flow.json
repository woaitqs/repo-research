  "cards": [
    {
      "dot": "emerald",
      "title": "What reaches the model",
      "items": [
        "System prompt = static sections (cache-marked) + dynamic block (skills, memory, secrets names, datetime)",
        "Only LLMConvertibleEvent subclasses enter the View; state updates and errors stay out",
        "Parallel tool calls are stored one event each and re-merged into one assistant message"
      ]
    },
    {
      "dot": "rose",
      "title": "How size is bounded",
      "items": [
        "Condenser triggers on CondensationRequest, token limit, or len(view) > max_size (default 240)",
        "Cuts snap to manipulation indices so tool_call/tool_result pairs and batches stay intact",
        "Terminal: tmux keeps 10k lines, the session cuts to 30,000 chars, then head + tail is kept and that text is saved under observations/"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime evidence (probe)",
      "items": [
        "Real SDK run with max_size=10: one Condensation forgot 8 events, summary inserted at offset 2",
        "seq 1 200000 reached the model as 30000 chars; all 17 events stayed on disk"
      ]
    }
  ]
