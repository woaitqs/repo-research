  "cards": [
    {
      "dot": "cyan",
      "title": "Context isolation",
      "items": [
        "The child starts from the default system prompt + definition body and only the prompt string; no parent history",
        "The parent sees one observation: the child's finish message (get_agent_final_response)",
        "Child events live in <parent>/subagents/, not in the parent event log"
      ]
    },
    {
      "dot": "emerald",
      "title": "What is shared",
      "items": [
        "Same workspace working_dir, so file changes are visible to the parent",
        "LLMCallContext is inherited; fresh tasks reuse the parent prompt_cache_key",
        "SubAgentScope can restrict child tools/MCP to a subset of the parent's"
      ]
    },
    {
      "dot": "amber",
      "title": "Variants",
      "items": [
        "DelegateTool: spawn up to 5 named children, run them in parallel threads, join",
        "WorkflowTool: an AST-checked async script calling run_agent / map_agents / pipeline over TaskManager"
      ]
    }
