  "cards": [
    {
      "dot": "cyan",
      "title": "Stateless vs stateful",
      "items": [
        "Agent and LLM are frozen Pydantic models; they can be shared across conversations",
        "All mutable state lives in ConversationState (+ EventLog); the agent reads conversation.state each step",
        "Tools come from Tool(name, params) specs resolved per conversation via the registry"
      ]
    },
    {
      "dot": "emerald",
      "title": "One API, two runtimes",
      "items": [
        "Conversation() returns LocalConversation for a path / LocalWorkspace",
        "It returns RemoteConversation for a RemoteWorkspace; that client drives an agent-server running LocalConversation"
      ]
    },
    {
      "dot": "amber",
      "title": "Resume contract",
      "items": [
        "base_state.json is the source of truth for the agent on resume",
        "AgentBase.verify(): tools may be added but never removed mid-conversation"
      ]
    }
  ]
