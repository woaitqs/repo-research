  "cards": [
    {
      "dot": "violet",
      "title": "Boundary",
      "items": [
        "the model only emits tool_calls and reads ToolMessages",
        "execution lives in middleware tools + the backend"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "HITL pauses before tools; permissions deny or interrupt by path",
        "LocalShellBackend has no isolation; sandboxes are BaseSandbox"
      ]
    },
    {
      "dot": "amber",
      "title": "Errors",
      "items": [
        "validation failures return error ToolMessages, not exceptions",
        "execute is hidden from the model when the backend has no shell"
      ]
    }
  ]
