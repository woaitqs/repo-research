  "cards": [
    {
      "dot": "cyan",
      "title": "Two processes",
      "items": [
        "dcode spawns `langgraph dev` and streams over HTTP/SSE via RemoteGraph",
        "--acp mode builds the same agent in-process instead"
      ]
    },
    {
      "dot": "emerald",
      "title": "Harness, not runtime",
      "items": [
        "create_deep_agent only assembles middleware + backend + profile",
        "the loop itself is LangChain create_agent on LangGraph"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "local mode: LocalShellBackend runs on the host, gated by HITL approvals",
        "--sandbox swaps the default backend for a BaseSandbox"
      ]
    }
  ]
