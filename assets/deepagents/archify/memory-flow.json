  "cards": [
    {
      "dot": "emerald",
      "title": "Explicit memory",
      "items": [
        "memory = plain AGENTS.md files the agent edits itself",
        "no vector store, no implicit extraction"
      ]
    },
    {
      "dot": "amber",
      "title": "Staleness",
      "items": [
        "memory_contents is cached in the checkpointed thread",
        "an edit mid-thread is not re-injected until a new thread (probe P6)"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "prompt frames memory as data, not instructions",
        "CLI rejects AGENTS.md symlinks escaping the project"
      ]
    }
