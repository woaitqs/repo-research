    {
      "dot": "emerald",
      "title": "Enters context",
      "items": [
        "system prompt + effective view + visible tool schemas",
        "skill bodies and offloaded data only via read_file, on demand"
      ]
    },
    {
      "dot": "amber",
      "title": "Kept out",
      "items": [
        "results > 20k tokens and inputs > 50k tokens become pointers",
        "summarized spans stay in state and in /conversation_history"
      ]
    },
    {
      "dot": "rose",
      "title": "Last resort",
      "items": [
        "ContextOverflowError: summarize, clip the tail, retry once",
