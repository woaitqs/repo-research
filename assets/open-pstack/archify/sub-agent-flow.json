      "dot": "emerald",
      "title": "Same prompt, different models",
      "items": [
        "the prompt is the contract; the rubric stays with the parent",
        "convergence is strong agreement; wild divergence means reframe"
      ]
    },
    {
      "dot": "cyan",
      "title": "Judge after terminal",
      "items": [
        "the cross-judge prefers a provider other than the parent and the likely base",
        "the parent still reads every candidate and scores criterion by criterion"
      ]
    },
    {
      "dot": "violet",
      "title": "Graft by hand",
      "items": [
        "one or two parts per losing candidate, folded in under one mental model",
