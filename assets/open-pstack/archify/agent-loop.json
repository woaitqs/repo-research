  "cards": [
    {
      "dot": "emerald",
      "title": "The parent keeps the lead",
      "items": [
        "it owns the design and reviews every delegate's diff",
        "a fix round goes to a fresh subagent with consolidated scope"
      ]
    },
    {
      "dot": "amber",
      "title": "Ask less, observe more",
      "items": [
        "a fork you could observe by running something is a prototype, not a question",
        "only irreversible writes pause for the operator"
      ]
    },
    {
      "dot": "rose",
      "title": "Measured: often skipped",
      "items": [
        "in 6 explicit headless sessions no parent opened the playbook todolist",
        "see the study's Verification section"
      ]
    }
