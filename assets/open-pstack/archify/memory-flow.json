  "cards": [
    {
      "dot": "emerald",
      "title": "No hidden memory",
      "items": [
        "everything durable is a file the operator can read",
        "the store lives outside the repo and the session"
      ]
    },
    {
      "dot": "amber",
      "title": "A gate before every write",
      "items": [
        "setup writes only after every probe passes, then reads back",
        "reflect waits for approval; correct proves a check fails on a real past mistake"
      ]
    },
    {
      "dot": "violet",
      "title": "Verdicts expire",
      "items": [
        "the ledger is keyed by PR and head SHA",
        "a new head means 'unverified' until a verifier writes a new row"
      ]
    }
  ]
