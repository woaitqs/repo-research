  "cards": [
    {
      "dot": "emerald",
      "title": "Types carry the rules",
      "items": [
        "a family's provider must be a registered adapter (ProviderId)",
        "only resolveLane builds a Lane; full access exists only on a writer"
      ]
    },
    {
      "dot": "cyan",
      "title": "Generated, not hand-kept",
      "items": [
        "the catalog and 25 native agent files come from render.ts",
        "skills name roles; a text scan rejects descriptors in prose"
      ]
    },
    {
      "dot": "violet",
      "title": "Policy stays in run.ts",
      "items": [
        "an adapter has no field for a timeout, a retry or another provider",
        "every lane ends in one receipt: complete or a named dropout"
      ]
    }
  ]
