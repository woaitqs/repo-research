  "cards": [
    {
      "dot": "emerald",
      "title": "One fan-out phase",
      "items": [
        "native and external lanes start together as background work with handles",
        "nothing reads a candidate until every lane is terminal"
      ]
    },
    {
      "dot": "cyan",
      "title": "A lane counts with proof",
      "items": [
        "external: a complete receipt with provider-report, or Codex's pinned argv",
        "native: the assigned model's transcript"
      ]
    },
    {
      "dot": "rose",
      "title": "Dropouts stay dropouts",
      "items": [
        "a missing CLI, login or model is recorded; the panel runs with N-1",
        "the closest model is never substituted: that would fake cross-provider agreement"
      ]
    }
  ]
